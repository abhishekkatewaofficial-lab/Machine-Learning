   "source": [
    "words = [\"eat\", \"tea\", \"tan\", \"ate\", \"nat\", \"bat\"]\n",
    "\n",
    "groups = {}\n",
    "\n",
    "for word in words:\n",
    "\n",
    "    key = ''.join(sorted(word))\n",
    "\n",
    "    if key not in groups:\n",
    "        groups[key] = []\n",
    "\n",
    "    groups[key].append(word)\n",
    "\n",
    "display(groups)\n",
    "\n",
    "print(list(groups.values()))"
   ]
  }
 ],
